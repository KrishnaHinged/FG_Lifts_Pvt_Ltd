# Database Connection
MONGODB_URI=mongodb://127.0.0.1:27017/fglifts

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here

# App URLs
NEXT_PUBLIC_URL=http://localhost:3000

# SMTP/Email Configuration (Optional for development)
# If omitted or SMTP_USER is blank, the app will log emails to local files in /scratch/emails/
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
